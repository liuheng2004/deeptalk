{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/deeptalk/deeptalk/blob/main/docs/contracts/analysis-result.schema.json",
  "title": "DeepTalkAnalysisResult",
  "description": "深度对话识别引擎(core/analysis)的输出。",
  "type": "object",
  "required": [
    "segment_id",
    "session_id",
    "depth_score",
    "dimensions",
    "start_time",
    "end_time",
    "summary",
    "messages"
  ],
  "properties": {
    "segment_id": {
      "type": "string",
      "description": "对话片段唯一 ID"
    },
    "session_id": {
      "type": "string",
      "description": "所属会话 ID(对应 session.schema.json)"
    },
    "depth_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "深度评分(加权合成)"
    },
    "threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "判定「深度对话」的阈值,由设置决定"
    },
    "is_deep": {
      "type": "boolean",
      "description": "depth_score >= threshold 时为 true"
    },
    "dimensions": {
      "type": "object",
      "required": ["emotion", "event", "continuity", "interaction"],
      "properties": {
        "emotion": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "情感深度:自我暴露、情绪倾诉、脆弱表达"
        },
        "event": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "关键节点:告白、道歉、和解、离别、重大决定"
        },
        "continuity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "主题连续性:围绕同一话题持续多轮、有推进"
        },
        "interaction": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "互动质量:倾听、共情、有效回应"
        }
      }
    },
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time"
    },
    "duration_minutes": {
      "type": "number",
      "minimum": 0
    },
    "summary": {
      "type": "string",
      "description": "三句话摘要"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "主题标签,如「深夜emo」「和好」「职业选择」"
    },
    "golden_quotes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "message_id"],
        "properties": {
          "text": {
            "type": "string"
          },
          "message_id": {
            "type": "string"
          }
        }
      },
      "description": "1-3 条金句"
    },
    "messages": {
      "type": "array",
      "description": "该片段包含的消息(与 session 中 message 结构一致,此处内嵌)",
      "items": {
        "type": "object"
      }
    },
    "model": {
      "type": "string",
      "description": "生成所用模型,如 deep-v4-flash"
    }
  }
}
