# DeepSeek API Key(deep-v4-flash / deep-v4-pro 共用同一把 Key)
DEEPSEEK_API_KEY=

# DeepSeek API 地址(默认官方,也可指向阿里云百炼等兼容端点)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 默认分析 / 回应模型(DeepSeek API 支持 deepseek-v4-flash / deepseek-v4-pro)
DEEPTALK_MODEL=deepseek-v4-flash

# 导出图片是否带品牌水印(true / false)
DEEPTALK_WATERMARK=true
